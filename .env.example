# Dynamic Schema - Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Required Settings
# =============================================================================

# Django Secret Key - REQUIRED in production (fails fast if unset)
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
POSTGRES_DB=dynamic_schema
POSTGRES_USER=dynamic_schema
POSTGRES_PASSWORD=your-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=s7,public

# =============================================================================
# Django Settings
# =============================================================================

# Debug mode (0 or 1, true or false)
# NOTE: only honored by config.settings.base - development.py forces
# DEBUG=True and production.py forces DEBUG=False, so this has no effect
# under the default settings modules (manage.py -> development,
# wsgi/asgi -> production).
DJANGO_DEBUG=1

# Allowed hosts - Comma-separated list
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Optional Settings
# =============================================================================

# NOTE: TIME_ZONE and LANGUAGE_CODE are NOT read from the environment -
# they are hardcoded in config/settings/base.py (UTC / en-us).
# TIME_ZONE=UTC
# LANGUAGE_CODE=en-us

# Skip the demo data in migration 0005_example_seed (1/true/yes/on)
# docker-compose.prod.yml sets this to 1 by default
# S7_SKIP_EXAMPLE_SEED=0

# =============================================================================
# Production Settings (enable when DEBUG=False)
# =============================================================================

# Static files URL for production
# STATIC_URL=/static/

# Media files URL for production
# MEDIA_URL=/media/

# Email configuration for production
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
